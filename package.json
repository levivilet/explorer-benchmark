{
  "name": "explorer-benchmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node packages/build/src/setup.ts",
    "build": "node packages/build/src/build.ts",
    "fixture": "node packages/benchmark/src/fixture.ts",
    "benchmark": "node packages/benchmark/src/run.ts",
    "report": "node packages/benchmark/src/report-all.ts",
    "merge": "node packages/benchmark/src/merge.ts",
    "test": "node --test packages/benchmark/test/core.test.ts packages/benchmark/test/merge.test.ts",
    "test:crash": "node --test packages/benchmark/test/crash.test.ts packages/benchmark/test/termination.test.ts",
    "serve": "node packages/benchmark/src/server.ts",
    "test:report": "node packages/benchmark/src/test-report.ts",
    "test:cdp": "node packages/benchmark/src/test-cdp.ts",
    "test:adapters": "node packages/benchmark/src/test-adapters.ts",
    "type-check": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
